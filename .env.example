# Copiez ce fichier en ".env.local" pour le développement local.
# Ces valeurs de configuration WEB Firebase ne sont pas des secrets (elles sont visibles
# dans tout site Firebase) : la sécurité repose sur les règles Firestore.
# NE METTEZ JAMAIS ici la clé de compte de service (FIREBASE_SERVICE_ACCOUNT).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Clé publique Web Push (certificat VAPID) : Firebase > Paramètres > Cloud Messaging
VITE_FIREBASE_VAPID_KEY=
